# recording a step's melody: Mel rec (Setup 3) replaces or layers; on the sequence's page OCT- held records the
# step at the cursor from the strings, after a bar's count-in, round and round; OCT- again stops (and the rhythm
# it started). Copied, pasted, taken away and saved as the made-up melodies are
wait 200
expect mellayer 0
tap GLO
tap GLO
tap GLO
expect view 6
spin K3 1
expect mellayer 1
wait 50
shot rec-setting.png
spin K3 -1
expect mellayer 0
tap REC
expect view 7
tapkey b1
tapkey b0
spin K1 -2
expect seqsel 0
expect mel 0
# OCT- held: counting in (the rhythm starts; OCT- let go does not make a melody)
press OCT-
wait 900
release OCT-
expect seqmel0 0
expect playing 1
expect rec 1
expect mel 80
shot rec-count.png
wait 1000
shot rec-count2.png
wait 1000
expect rec 2
expect seqat 0
tapkey w4
wait 400
tapkey w7
wait 400
tapkey w9
wait 300
shot rec-recording.png
wait 1000
# the time round ended: a take, kept as the step's melody
expect seqnotes0 3
expect seqnote0.0 >0
wait 1500
expect seqnotes0 3
tap OCT-
wait 100
expect rec 0
expect playing 0
shot rec-done.png
# copied to the next step, taken away there
tap OCT+
spin K1 1
tap OCT+
expect seqnotes1 3
expect seqmel1 0
press OCT+
wait 900
release OCT+
expect seqnotes1 0
# PLAY: the step's notes sound on it, nothing on the next
tap PLAY
wait 1200
expect seqat 0
expect mellevel >0
wait 1000
expect seqat 1
expect mellevel 0
tap PLAY
wait 300
# saved
tap SAVE
reboot
wait 100
expect seqnotes0 3
expect seqnotes1 0
# layering: a note added
tap GLO
tap GLO
tap GLO
spin K3 1
expect mellayer 1
tap REC
expect view 7
spin K1 -5
expect seqsel 0
press OCT-
wait 900
release OCT-
wait 2400
shot rec-layer.png
tapkey w12
wait 2000
expect seqnotes0 4
tap OCT-
wait 100
expect rec 0
# PLAY stops recording too
press OCT-
wait 900
release OCT-
expect rec 1
tap PLAY
wait 100
expect rec 0
expect playing 0
# OCT-: a made-up melody in its place
tap OCT-
expect seqnotes0 0
expect seqmel0 >0
