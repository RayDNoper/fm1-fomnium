# chord buttons, the OM rows (ENV minor, LFO 7th, both m7), CHORD HOLD, SYNC START, saving
wait 200
# F (button 0), then ENV held: F minor; LFO: F7; both: Fm7
tapkey b0
expect root 5
expect type 0
press ENV
tapkey b0
release ENV
expect type 1
press LFO
tapkey b0
release LFO
expect type 2
press ENV
press LFO
tapkey b0
release LFO
release ENV
expect type 4
# a modifier used with a chord does not open its page
expect view 0
# the strings follow the chord: F7 is F A Eb, F3 A3 Eb3 on strings 0..2 (Eb folded up to F#2..F3)
tapkey b0
press LFO
tapkey b0
release LFO
expect strnote0 53
expect strnote1 45
expect strnote2 51
# Strings (Setup, KNOB 1). Fixed: each white key its own note (F3..G5), whatever the chord
tap GLO
# (Shift, KNOB 2, is for Relative only)
spin K2 2
expect shift 0
spin K1 1
wait 50
expect plate 1
expect strnote1 55
expect strnote15 79
tapkey b1
expect strnote1 55
shot scale.png
# Relative: the chord's scale from its root. C: C3 D3 ... ; A minor (button 4): A3 B3 C4
spin K1 1
wait 50
expect plate 2
expect strnote0 48
expect strnote1 50
expect strnote15 74
tapkey b4
expect strnote0 57
expect strnote2 60
shot relscale.png
# Shift moves that scale along the keys: two steps down, A minor from F3, its A3 on the third key
spin K2 -2
wait 50
expect shift -2
expect strnote0 53
expect strnote1 55
expect strnote2 57
shot relshift.png
spin K2 -9
expect shift -6
spin K2 6
wait 50
expect shift 0
expect strnote0 57
spin K1 -2
wait 50
expect plate 0
expect strnote1 48
tapkey b1
tap HOME
# without HOLD the chord stops when let go
tapkey b1
wait 400
expect chord_level 0
# CHORD HOLD: it keeps going; the same button again stops it
tap ARP
expect hold 1
tapkey b2
wait 400
expect chord_level >50
expect pad 2
tapkey b2
wait 400
expect chord_level 0
expect pad -1
tap ARP
expect hold 0
# SYNC START: PLAY waits for a chord
tap REC
expect sync 1
tap PLAY
expect armed 1
expect playing 0
wait 100
key b3 down
wait 20
expect playing 1
expect armed 0
key b3 up
tap PLAY
expect playing 0
# OCT+ moves the plate up
tap OCT+
expect par13 1
tap OCT-
expect par13 0
# PRESETS picks the chord set: the second is the same buttons in G, and it does not go past the last
turn PRESET 1
expect set 1
tapkey b1
expect root 7
turn PRESET 9
expect set 7
turn PRESET -9
expect set 0
# a held chord goes to its button's chord in the new set
tap ARP
tapkey b1
expect root 0
turn PRESET 1
expect root 7
expect pad 1
turn PRESET -1
expect root 0
tapkey b1
tap ARP
# the CHORDS page: press a button, change its chord; KNOB 3 transposes
tap SEL
expect view 3
spin K3 2
expect par12 2
tapkey b10
spin K1 -2
spin K2 -2
expect padroot10 7
expect padtype10 0
shot chords.png
# the change is in that set only
turn PRESET 1
expect padroot10 4
expect padtype10 2
shot set2.png
# it saves by itself when quiet, and comes back after a restart
wait 5000
expect dirty 0
reboot
wait 100
expect set 1
expect padroot10 4
turn PRESET -1
expect padroot10 7
expect par12 2
expect sync 1
shot after_reboot.png
# Chord rev comes back at its default
expect par11 25
