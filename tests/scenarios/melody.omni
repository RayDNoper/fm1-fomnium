# the melody: HOME again for its page, switched on, playing with the rhythm while a chord is held; saved
wait 200
expect mel 0
expect melseed 1
expect view 0
tap HOME
expect view 8
spin K1 80
expect mel 80
spin K3 4
expect melseed 5
spin K3 -10
expect melseed 1
spin K3 4
# no chord: the rhythm plays, the melody waits
tap PLAY
wait 1500
expect mellevel 0
# C held: it plays
key b1 down
wait 3000
expect playing 1
expect mellevel >0
shot melody.png
key b1 up
tap PLAY
wait 800
expect mellevel 0
# off again shows Off; the settings are kept
spin K1 -80
expect mel 0
spin K1 60
tap SAVE
reboot
wait 100
expect mel 60
expect melseed 5
# HOME from the melody's page: back to Play
tap HOME
expect view 8
tap HOME
expect view 0
# the sequence's melodies: on its page, OCT- makes one for the step at the cursor, OCT+ copies and pastes,
# OCT+ held takes it away; they play on their steps, and are saved
expect playing 0
tap HOME
expect view 8
spin K1 -60
expect mel 0
tap REC
expect view 7
tapkey b1
tapkey b0
expect seqsel 2
tap OCT-
expect seqmel2 0
spin K1 -2
expect seqsel 0
expect par13 0
tap OCT-
expect seqmel0 >0
expect par13 0
expect mel 80
shot seq-melody.png
tap OCT+
spin K1 1
tap OCT+
expect seqmel1 >0
press OCT+
wait 900
release OCT+
expect seqmel1 0
tap OCT+
expect seqmel1 >0
press OCT+
wait 900
release OCT+
expect seqmel1 0
# PLAY: the first step's melody sounds, the second step's (none) is silent
tap PLAY
wait 1500
expect seqat 0
expect mellevel >0
wait 2200
expect seqat 1
expect mellevel 0
tap PLAY
wait 300
tap SAVE
reboot
wait 100
expect seqmel0 >0
expect seqmel1 0
